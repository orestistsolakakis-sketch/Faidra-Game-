<Project Sdk="Godot.NET.Sdk/4.3.0">
  <!--
    Lumenfall (working title) — C# game assembly for a Godot 4 project.

    We use C# (over GDScript) because this game is a large, multi-system
    codebase (quests, dialogue graphs, relationship state, save
    serialization). A real type system, interfaces and generics keep those
    systems maintainable as they grow. The Godot.NET.Sdk wires Godot's
    engine types and the build into `dotnet`.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Lumenfall</RootNamespace>
  </PropertyGroup>
</Project>
