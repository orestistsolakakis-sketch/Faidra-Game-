; Engine configuration file for The Heart Engine (working codename "Lumenfall").
; Godot 4.x, GDScript. GDScript (not C#) is used so the project can export to the
; web/browser. See docs/ARCHITECTURE.md.

config_version=5

[application]

config/name="Lumenfall (Working Title)"
config/description="A 3D story-driven adventure of ancient magic and forgotten technology."
run/main_scene="res://scenes/Boot/Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

; Autoloads are global singletons available from any script.
; GameManager     -> owns high-level game state (the spine of the game).
; GameModeManager -> interaction mode within gameplay (Exploration/Cinematic/...).
; SceneLoader     -> performs async, faded scene transitions.
; World           -> narrative simulation facade (World Time + fact store).
; Order matters: services are constructed top-to-bottom (GameModeManager
; depends on GameManager existing first).
[autoload]

GameManager="*res://src/core/game_manager.gd"
GameModeManager="*res://src/core/game_mode_manager.gd"
SceneLoader="*res://src/core/scene_loader.gd"
World="*res://src/narrative/world.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.05, 0.06, 0.09, 1)
