; Engine configuration file for Lumenfall (working title).
; Godot 4.x project. Kept intentionally minimal and hand-editable so it
; produces clean, reviewable git diffs. See docs/ARCHITECTURE.md.

config_version=5

[application]

config/name="Lumenfall (Working Title)"
config/description="A 3D story-driven adventure of ancient magic and forgotten technology."
run/main_scene="res://scenes/Boot/Main.tscn"
config/features=PackedStringArray("4.3", "C#", "Forward Plus")
config/icon="res://icon.svg"

[dotnet]

project/assembly_name="Lumenfall"

; Autoloads are global singletons available from any script.
; GameManager     -> owns high-level game state (the spine of the game).
; GameModeManager -> interaction mode within gameplay (Exploration/Cinematic/...).
; SceneLoader     -> performs async, faded scene transitions.
; World           -> narrative simulation facade (World Time + fact store).
; Order matters: services are constructed top-to-bottom (GameModeManager
; depends on GameManager existing first).
[autoload]

GameManager="*res://src/Core/GameManager.cs"
GameModeManager="*res://src/Core/GameModeManager.cs"
SceneLoader="*res://src/Core/SceneLoader.cs"
World="*res://src/Narrative/World.cs"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="forward_plus"
environment/defaults/default_clear_color=Color(0.05, 0.06, 0.09, 1)
