class_name PersonalityTraits
## Trait ids each character accrues through dialogue choices (see
## docs/DIALOGUE_SYSTEM_BIBLE.md). The player never picks a personality — choices
## add weight and the dominant one emerges. Ids namespaced by character.


class Arlen:
	const PROTECTIVE := "arlen_protective"
	const CYNICAL := "arlen_cynical"
	const COMPASSIONATE := "arlen_compassionate"
	const SELF_SACRIFICING := "arlen_self_sacrificing"
	const INDEPENDENT := "arlen_independent"


